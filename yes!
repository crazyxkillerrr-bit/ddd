--// NEAREST ENEMY TELEPORT GUI
--// For your own Roblox game
--// Place this LocalScript inside StarterPlayer > StarterPlayerScripts

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

--==================================================
-- SETTINGS
--==================================================

local distanceBelow = 10
local autoTeleport = false
local toggleKey = Enum.KeyCode.RightShift

--==================================================
-- CHARACTER
--==================================================

local function getCharacter()
	return LocalPlayer.Character
end

local function getRoot(character)
	return character and character:FindFirstChild("HumanoidRootPart")
end

--==================================================
-- FIND NEAREST ENEMY
--==================================================

local function getNearestEnemy()
	local character = getCharacter()
	local root = getRoot(character)

	if not root then
		return nil
	end

	local nearest = nil
	local nearestDistance = math.huge

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local enemyCharacter = player.Character
			local enemyRoot = getRoot(enemyCharacter)
			local humanoid = enemyCharacter and enemyCharacter:FindFirstChildOfClass("Humanoid")

			if enemyRoot and humanoid and humanoid.Health > 0 then
				local distance = (root.Position - enemyRoot.Position).Magnitude

				if distance < nearestDistance then
					nearestDistance = distance
					nearest = enemyCharacter
				end
			end
		end
	end

	return nearest, nearestDistance
end

--==================================================
-- TELEPORT
--==================================================

local function teleportUnderNearestEnemy()
	local character = getCharacter()
	local root = getRoot(character)

	if not root then
		return
	end

	local enemy, distance = getNearestEnemy()

	if not enemy then
		return
	end

	local enemyRoot = getRoot(enemy)

	if not enemyRoot then
		return
	end

	-- Put the player directly underneath the enemy.
	local targetPosition =
		enemyRoot.Position - Vector3.new(0, distanceBelow, 0)

	-- Keep the player's current rotation.
	root.CFrame = CFrame.new(targetPosition) * CFrame.Angles(
		root.Orientation.X * math.pi / 180,
		root.Orientation.Y * math.pi / 180,
		root.Orientation.Z * math.pi / 180
	)
end

